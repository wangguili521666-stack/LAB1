{
  "name": "d2-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "D2 教室与座位主数据服务",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node scripts/migrate.js",
    "test": "node --test tests/unit/*.test.js",
    "test:integration": "node scripts/test-integration.js",
    "premigrate": "node migration-check.mjs",
    "postmigrate": "npm run seed",
    "seed": "node seed.mjs",
    "migration:register": "node migration-check.mjs --register"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.11.0"
  }
}
