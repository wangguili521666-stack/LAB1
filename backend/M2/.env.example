# M2 服务端口（团队端口方案：m1=3001 m2=3002 m3=3003 d1=3004 d2=3005 d3=3006）
PORT=3002

# 数据库：共享 MySQL 中的 campus_m2，账号只拥有本库权限。
# DB_PASSWORD 必须与仓库根目录 .env 的 M2_DB_PASSWORD 一致。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campus_m2
DB_USER=m2_app
DB_PASSWORD=change_me_m2
DB_TIMEZONE=+08:00

# 与 D1 相同的登录签名密钥，只用于校验用户 JWT，不用于签发。
JWT_SECRET=change_me_jwt_secret

# 跨模块地址。Compose 网络内使用服务名。
D1_BASE_URL=http://127.0.0.1:3004
D2_BASE_URL=http://127.0.0.1:3005
D3_BASE_URL=http://127.0.0.1:3006
INTERNAL_SERVICE_TOKEN=

# 从提交到两级审批全部完成的时限（小时），超时视为拒绝。
M2_APPROVAL_TIMEOUT_HOURS=24
