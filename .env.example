# ============ 共享 MySQL（六个模块共用一个实例） ============
# root 账号仅用于初始化与运维，业务服务一律不要用 root。
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_PORT=3306

# ============ 各模块数据库账号（每个服务只连自己的库） ============
# 库名固定为 campus_<模块名>，用户名固定为 <模块名>_app，由 db/init 脚本创建。
# 密码请改成强随机值；避免使用单引号等特殊字符。
M1_DB_PASSWORD=change_me_m1
M2_DB_PASSWORD=change_me_m2
M3_DB_PASSWORD=change_me_m3
D1_DB_PASSWORD=change_me_d1
D2_DB_PASSWORD=change_me_d2
D3_DB_PASSWORD=change_me_d3

# D1 登录签名密钥；start.sh 会自动生成随机值。M2 用同一个密钥校验登录态。
D1_JWT_SECRET=

# 模块之间调用时放在 X-Service-Token。留空则 M2 不发送该请求头。
INTERNAL_SERVICE_TOKEN=
# 教室申请从提交到两级审批完成的时限（小时），超时视为拒绝。
M2_APPROVAL_TIMEOUT_HOURS=24
