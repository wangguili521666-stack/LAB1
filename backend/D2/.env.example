# 本机开发。D1 当前仅通过前端代理暴露；容器内应改成 http://d1:3004。
HOST=127.0.0.1
PORT=3005
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campus_d2
DB_USER=d2_app
# 填入根目录 .env 的 D2_DB_PASSWORD，不使用 root。
DB_PASSWORD=
D1_BASE_URL=http://127.0.0.1:5173
DEPENDENCY_TIMEOUT_MS=3000
# D3 尚未实现时留空，审计会保存在 D2 outbox；上线后填写真实服务地址和可信服务凭证。
D3_BASE_URL=
D3_SERVICE_TOKEN=
AUDIT_POLL_MS=2000
# 各模块独立随机密钥，至少 32 个字符；留空表示不启用该服务身份。
D2_M1_SERVICE_TOKEN=
D2_M2_SERVICE_TOKEN=
D2_M3_SERVICE_TOKEN=
HOLD_TTL_SECONDS=300
EXPIRY_POLL_MS=5000
BUSINESS_UTC_OFFSET=+08:00
