HOST=127.0.0.1
PORT=3006
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campus_d3
DB_USER=d3_app
DB_PASSWORD=
D1_BASE_URL=http://127.0.0.1:3004
D1_TIMEOUT_MS=3000
# 每个调用模块使用独立的随机凭据；至少 32 个字符，禁止与用户 JWT 共用。
# 示例仅说明格式，启动前填写真实随机值，不要提交 .env。
D3_SERVICE_TOKENS={}
# 公告管理：OPERATION_ADMIN / SYSTEM_ADMIN；审计查询：SYSTEM_ADMIN。
# 默认无跨域许可。独立前端联调时设置精确来源，例如 http://localhost:5173。
D3_CORS_ORIGIN=
