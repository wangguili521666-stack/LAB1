# D1 服务端口（团队端口方案：m1=3001 m2=3002 m3=3003 d1=3004 d2=3005 d3=3006）
PORT=3004

# 数据库：对应共享 MySQL 里的 campus_d1 库（账号由仓库根目录 db/init 创建）
# 注意：DB_PASSWORD 要与仓库根目录 .env 里的 D1_DB_PASSWORD 一致。
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campus_d1
DB_USER=d1_app
DB_PASSWORD=change_me_d1
# 约定时区偏移：数据库 DATETIME 按本地时区存储，输出时拼上该偏移（简化为不做真实时区转换）
DB_TIMEZONE=+08:00

# JWT
JWT_SECRET=change_me_jwt_secret
JWT_EXPIRES_IN=86400
